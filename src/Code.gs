  html += '<div class="stat-mini"><div class="value">' + stats.pendingTasks + '</div><div class="label">Pending</div></div>';
  html += '<div class="stat-mini"><div class="value overdue">' + stats.overdueTasks + '</div><div class="label">Overdue</div></div>';
