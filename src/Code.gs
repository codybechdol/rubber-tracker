/**
 * Sets up the AED sheet with proper structure, formatting, and data validation.
 * Creates the sheet if it doesn't exist, or configures an existing empty sheet.
 * AED columns: A=Item#, B=Model, C=(unused), D=Pad Expiration, E=Date Assigned,
 *              F=Location, G=Status, H=Assigned To, I=(unused), J=Picked For, K=Notes
 */
function setupAEDSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var ui = SpreadsheetApp.getUi();
  var sheet = ss.getSheetByName(SHEET_AED);
  var isNew = false;

  if (!sheet) {
    sheet = ss.insertSheet(SHEET_AED);
    isNew = true;
    Logger.log('setupAEDSheet: Created new AED sheet');
  } else {
    if (sheet.getLastRow() > 1) {
      var resp = ui.alert('AED Sheet Setup',
        'The AED sheet already has data (' + (sheet.getLastRow() - 1) + ' rows).\n\n' +
        'Do you want to re-apply formatting and validation without clearing data?',
        ui.ButtonSet.YES_NO);
      if (resp !== ui.Button.YES) return;
    }
    Logger.log('setupAEDSheet: Configuring existing AED sheet');
  }

  // Headers
  var headers = ['AED', 'Model', '', 'Pad Expiration', 'Date Assigned', 'Location', 'Status', 'Assigned To', '', 'Picked For', 'Notes'];
  var headerRange = sheet.getRange(1, 1, 1, headers.length);
  headerRange.setValues([headers]);
  headerRange.setBackground('#c62828');  // Red for AED
  headerRange.setFontColor('#ffffff');
  headerRange.setFontWeight('bold');
  headerRange.setHorizontalAlignment('center');
  sheet.setFrozenRows(1);

  // Column widths
  var columnWidths = [80, 120, 50, 120, 110, 100, 110, 130, 50, 150, 200];
  for (var i = 0; i < columnWidths.length; i++) {
    sheet.setColumnWidth(i + 1, columnWidths[i]);
  }

  // Ensure enough rows for validation
  if (sheet.getMaxRows() < 101) {
    sheet.insertRowsAfter(Math.max(1, sheet.getMaxRows()), 101 - sheet.getMaxRows());
  }

  // Status dropdown (column G = 7)
  var statusValidation = SpreadsheetApp.newDataValidation()
    .requireValueInList(['On Shelf', 'In Service', 'Out of Service', 'Retired', 'Lost'], true)
    .setAllowInvalid(false)
    .build();
  sheet.getRange(2, COLS.AED.STATUS, 100, 1).setDataValidation(statusValidation);

  // Date formatting for Pad Expiration (col D) and Date Assigned (col E)
  try {
    sheet.getRange(2, COLS.AED.PAD_EXPIRATION, 100, 1).setNumberFormat('mm/dd/yyyy');
  } catch (e) { Logger.log('setupAEDSheet: Could not set date format for Pad Expiration: ' + e); }
  try {
    sheet.getRange(2, COLS.AED.DATE_ASSIGNED, 100, 1).setNumberFormat('mm/dd/yyyy');
  } catch (e) { Logger.log('setupAEDSheet: Could not set date format for Date Assigned: ' + e); }

  // Assigned To dropdown from Employees + special values
  try {
    var employeesSheet = ss.getSheetByName(SHEET_EMPLOYEES);
    if (employeesSheet && employeesSheet.getLastRow() > 1) {
      var empNames = employeesSheet.getRange(2, 1, employeesSheet.getLastRow() - 1, 1).getValues()
        .map(function(r) { return r[0].toString().trim(); })
        .filter(function(n) { return n !== ''; })
        .sort();
      var assignedOptions = ['On Shelf', 'Out of Service', 'Retired', 'Lost'].concat(empNames);
      var assignedValidation = SpreadsheetApp.newDataValidation()
        .requireValueInList(assignedOptions, true)
        .setAllowInvalid(true)
        .build();
      sheet.getRange(2, COLS.AED.ASSIGNED_TO, 100, 1).setDataValidation(assignedValidation);
    }
  } catch (e) {
    Logger.log('setupAEDSheet: Could not set Assigned To validation: ' + e);
  }

  // Text wrap for Notes column (K = 11)
  sheet.getRange(2, COLS.AED.NOTES, 100, 1).setWrap(true);

  // Hide unused columns C and I
  try {
    sheet.hideColumns(3);  // Column C (unused)
    sheet.hideColumns(9);  // Column I (unused)
  } catch (e) {
    Logger.log('setupAEDSheet: Could not hide unused columns: ' + e);
  }

  // Set AED model dropdown (common models)
  var modelValidation = SpreadsheetApp.newDataValidation()
    .requireValueInList(['Philips HeartStart FRx', 'Philips HeartStart OnSite', 'ZOLL AED Plus', 'ZOLL AED 3', 'Physio-Control LIFEPAK CR2', 'Defibtech Lifeline AED', 'Cardiac Science Powerheart G5', 'Other'], true)
    .setAllowInvalid(true)
    .build();
  sheet.getRange(2, COLS.AED.MODEL, 100, 1).setDataValidation(modelValidation);

  Logger.log('setupAEDSheet: Setup complete');

  if (isNew) {
    ui.alert('✅ AED Sheet Created!\n\nThe AED sheet has been set up with:\n' +
      '• Status dropdown (On Shelf, In Service, Out of Service, Retired, Lost)\n' +
      '• Model dropdown (common AED models)\n' +
      '• Assigned To dropdown (employees + special values)\n' +
      '• Date formatting for Pad Expiration and Date Assigned\n\n' +
      'Add your AED units to start tracking pad expirations.');
  } else {
    ui.alert('✅ AED Sheet Updated!\n\nFormatting and validation re-applied.');
  }
}




