/**
 * Removes auto-generated cert renewal tasks from the Manual Tasks sheet.
 * These tasks (with Notes matching "Renew X | Employee: Y | Current Expiration: ...") were
 * written by the old generateToDoTasksFromCerts() and should no longer exist in Manual Tasks.
 * Cert tasks now flow through Task Metadata via collectExpiringCertTasks().
 * @return {number} Number of rows removed
 */
function cleanupCertTasksFromManualTasks() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName('Manual Tasks');
  if (!sheet || sheet.getLastRow() < 2) return 0;

  var data = sheet.getDataRange().getValues();
  // Pattern for auto-generated cert notes: "Renew X | Employee: Y | Current Expiration: ..."
  var certNotesPattern = /^Renew\s+.+\|\s*Employee:\s*.+\|\s*Current Expiration:/i;
  var rowsToDelete = [];

  for (var i = data.length - 1; i >= 1; i--) {
    var taskType = String(data[i][2] || '').trim();
    var notes = String(data[i][8] || '').trim();
    var manuallyCreated = data[i][14]; // Column O (index 14)

    // Only delete rows that look like auto-generated cert tasks (not user-created)
    if (taskType.indexOf('Renew ') === 0 && certNotesPattern.test(notes) && !manuallyCreated) {
      rowsToDelete.push(i + 1); // 1-based
    }
  }

  for (var d = 0; d < rowsToDelete.length; d++) {
    sheet.deleteRow(rowsToDelete[d]);
  }

  if (rowsToDelete.length > 0) {
    Logger.log('cleanupCertTasksFromManualTasks: Removed ' + rowsToDelete.length + ' auto-generated cert tasks from Manual Tasks sheet');
  }
  return rowsToDelete.length;
}

/**
 * Applies conditional formatting to Expiring Certs sheet.
 */
function applyExpiringCertsFormatting(sheet, dataRows) {
  if (!dataRows || dataRows < 1) return;

  var fullRowRange = sheet.getRange(2, 1, dataRows, 9); // Columns A through I
  var statusRange = sheet.getRange(2, 8, dataRows, 1);  // Column H (Status column)
  var rules = [];

  // 1. PRIORITY - Need Copy (Full Row A-I - Purple)
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=$H2="PRIORITY - Need Copy"')
    .setBackground('#9c27b0')
    .setFontColor('#ffffff')
    .setRanges([fullRowRange])
    .build());

  // 2. EXPIRED (Full Row A-I - Red)
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=OR($H2="EXPIRED", AND(ISNUMBER(SEARCH("Non-CDL",$H2)), ISNUMBER($G2), $G2<0))')
    .setBackground('#ea4335')
    .setFontColor('#ffffff')
    .setRanges([fullRowRange])
    .build());

  // 3. CRITICAL (Full Row A-I - Dark Orange)
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=OR($H2="CRITICAL", AND(ISNUMBER(SEARCH("Non-CDL",$H2)), ISNUMBER($G2), $G2>=0, $G2<=7))')
    .setBackground('#ff6d00')
    .setFontColor('#ffffff')
    .setRanges([fullRowRange])
    .build());

  // 4. WARNING (Full Row A-I - Yellow)
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=OR($H2="WARNING", AND(ISNUMBER(SEARCH("Non-CDL",$H2)), ISNUMBER($G2), $G2>7, $G2<=30))')
    .setBackground('#fbbc04')
    .setFontColor('#000000')
    .setRanges([fullRowRange])
    .build());

  // 5. UPCOMING (Full Row A-I - Soft Blue)
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=OR($H2="UPCOMING", AND(ISNUMBER(SEARCH("Non-CDL",$H2)), ISNUMBER($G2), $G2>30, $G2<=60))')
    .setBackground('#4285f4')
    .setFontColor('#ffffff')
    .setRanges([fullRowRange])
    .build());

  // 6. OK (Status Column H only - Green)
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=OR($H2="OK", AND(ISNUMBER(SEARCH("Non-CDL",$H2)), ISNUMBER($G2), $G2>60))')
    .setBackground('#34a853')
    .setFontColor('#ffffff')
    .setRanges([statusRange])
    .build());

  // 7. Non-Expiring (Full Row A-I - Gray)
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=$H2="Non-Expiring"')
    .setBackground('#757575')
    .setFontColor('#ffffff')
    .setRanges([fullRowRange])
    .build());

  // 8. No Date Set & NOT REQUIRED (Full Row A-I - Gray)
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=OR($H2="No Date Set", $H2="NOT REQUIRED", AND(ISNUMBER(SEARCH("Non-CDL",$H2)), OR($G2="N/A", ISBLANK($G2))))')
    .setBackground('#757575')
    .setFontColor('#ffffff')
    .setRanges([fullRowRange])
    .build());

  sheet.setConditionalFormatRules(rules);
}

