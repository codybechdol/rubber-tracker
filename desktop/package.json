{
  "name": "safety-assistant-desktop",
  "version": "1.0.0",
  "description": "Safety Assistant - Offline Field Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": ["safety", "ppe", "offline", "field"],
  "author": "Safety Assistant",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "dexie": "^4.0.10"
  },
  "build": {
    "appId": "com.safetyassistant.desktop",
    "productName": "Safety Assistant",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Safety Assistant"
    }
  }
}
